{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src", "tools", "tests"]
}
